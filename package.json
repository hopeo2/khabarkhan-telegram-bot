{
  "name": "telegram-mohtava-00",
  "private": true,
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "migrate": "tgcloud migrate",
    "tick": "tgcloud run endpoints/scheduler '{\"force\":false}'",
    "post": "tgcloud run endpoints/scheduler '{\"force\":true}'",
    "post:news": "tgcloud run endpoints/scheduler '{\"force\":true,\"categories\":[\"news\"]}'",
    "post:sports": "tgcloud run endpoints/scheduler '{\"force\":true,\"categories\":[\"sports\"]}'"
  }
}
